\t\tt.Fatalf("unexpected shell output: %q", out)
\t}
\tif _, err := os.Stat(marker); !os.IsNotExist(err) {
\t\tt.Fatalf("worker-controlled startup state executed; stat err=%v", err)
\t}
}

func TestRootCommandAndJobIgnoreWorkerStartupFiles(t *testing.T) {
\tif os.Geteuid() != 0 {
\t\tt.Skip("privileged execution behavior is exercised under sudo in High Assurance Security")
\t}
\tworkspace := t.TempDir()
\tstate := t.TempDir()
\tjobs := filepath.Join(state, "jobs")
\tif err := os.Mkdir(jobs, 0711); err != nil {
\t\tt.Fatal(err)
\t}
\tmarker := filepath.Join(t.TempDir(), "worker-startup-ran")
\tpayload := []byte("printf pwned > " + marker + "\\n")
\tfor _, name := range []string{".bash_profile", ".bash_login", ".profile", ".bashrc"} {
\t\tif err := os.WriteFile(filepath.Join(workspace, name), payload, 0644); err != nil {
\t\t\tt.Fatal(err)
\t\t}
\t}
\tbashEnv := filepath.Join(workspace, "bash-env")
\tif err := os.WriteFile(bashEnv, payload, 0644); err != nil {
\t\tt.Fatal(err)
\t}
\tt.Setenv("BASH_ENV", bashEnv)
\tt.Setenv("ENV", bashEnv)

\ts := &Server{
\t\tcfg: config.Config{
\t\t\tWorkspaceDir: workspace,
\t\t\tStateDir:     state,
\t\t\tWorkerUser:   "root",
\t\t},
\t\tguard:     policy.New(nil),
\t\taudit:     audit.New(filepath.Join(t.TempDir(), "audit.jsonl")),
\t\tworkerUID: 0,
\t\tworkerGID: 0,
\t}
\tresp := s.run(Request{Command: "printf safe", Root: true, Approval: true})
\tif !resp.OK || resp.Output != "safe" {
\t\tt.Fatalf("root command failed: %+v", resp)
\t}
\tif _, err := os.Stat(marker); !os.IsNotExist(err) {
\t\tt.Fatalf("root command executed worker startup state; stat err=%v", err)
\t}

\tfakeBin := t.TempDir()
\tfakeSystemdRun := filepath.Join(fakeBin, "systemd-run")
\tfakeScript := `#!/bin/sh
set -e
while [ "$#" -gt 0 ]; do
  case "$1" in
    --unit) shift 2 ;;
    --collect|--property=*|--uid=*) shift ;;
    /usr/bin/env) exec "$@" ;;
    *) echo "unexpected systemd-run test arg: $1" >&2; exit 64 ;;
  esac
done
exit 65
`
\tif err := os.WriteFile(fakeSystemdRun, []byte(fakeScript), 0755); err != nil {
\t\tt.Fatal(err)
\t}
\tt.Setenv("PATH", fakeBin+":"+os.Getenv("PATH"))
\tjob := s.startJob(Request{Command: "printf safe", Root: true, Approval: true})
\tif !job.OK || job.JobID == "" {
\t\tt.Fatalf("root job failed: %+v", job)
\t}
\tif _, err := os.Stat(marker); !os.IsNotExist(err) {
\t\tt.Fatalf("root job executed worker startup state; stat err=%v", err)
\t}
\tlogBytes, err := os.ReadFile(filepath.Join(jobs, job.JobID+".log"))
\tif err != nil {
\t\tt.Fatal(err)
\t}
\tif string(logBytes) != "safe" {
\t\tt.Fatalf("root job output = %q, want safe", logBytes)
\t}
}

func TestRootJobInvocationSanitizesEnvironment(t *testing.T) {
\tsource, err := os.ReadFile("executor.go")
\tif err != nil {
\t\tt.Fatal(err)
\t}
\ttext := string(source)
\tfor _, want := range []string{"/usr/bin/env", `"-i"`, `"HOME="+home`, `"/bin/bash", "--noprofile", "--norc", "-c"`} {
\t\tif !strings.Contains(text, want) {
\t\t\tt.Fatalf("startJob is missing sanitized invocation contract %q", want)
\t\t}
\t}
\tif strings.Contains(text, `"/bin/bash", "-lc", shell`) || strings.Contains(text, `--setenv=HOME=`) {
\t\tt.Fatal("startJob still contains login-shell or inherited-HOME behavior")
\t}
}
''')

