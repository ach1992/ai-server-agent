STATE_DIR="$TMP/state"; CONFIG_DIR="$TMP/config"; CONTROL_DIR="$CONFIG_DIR/control"; TLS_DIR="$CONFIG_DIR/tls"; CONFIG_FILE="$CONFIG_DIR/config.json"; MANAGED_STATE="$CONFIG_DIR/managed.json"; CF_TXN_STATE="$CONTROL_DIR/cloudflare-transaction.json"; CF_TXN_BACKUP_DIR="$CONTROL_DIR/cloudflare-transaction-backup"
mkdir -p "$STATE_DIR" "$CONFIG_DIR" "$CONTROL_DIR" "$TLS_DIR"
systemctl(){ return 0; }
DELETE_LOG="$TMP/deletes.log"; : > "$DELETE_LOG"
cf_delete_owned(){ printf '%s\n' "$1" >> "$DELETE_LOG"; return 0; }
cf_recover_pending_write(){ cf_clear_pending_write; return 0; }
old_config='{"listen_address":"127.0.0.1:3210","tls_cert_file":"","tls_key_file":""}'
old_managed='{"active_provider":"local","hostname":"old.example.com","port":3210,"cloudflare":{}}'
printf '%s\n' "$old_config" > "$CONFIG_FILE"
printf '%s\n' "$old_managed" > "$MANAGED_STATE"
printf 'old-key\n' > "$TLS_DIR/origin.key"
printf 'old-crt\n' > "$TLS_DIR/origin.crt"
chmod 0640 "$CONFIG_FILE" "$MANAGED_STATE" "$TLS_DIR/origin.key"; chmod 0644 "$TLS_DIR/origin.crt"

seed_remote_state(){
  host=mcp.example.com; zone_id=zone1; old_port=3210
  dns_id=dns-new; dns_action=created; dns_old_content=""; dns_old_proxied=""; dns_old_ttl=""
  origin_ruleset_id=origin-set; origin_rule_id=origin-rule; origin_action=created
  ssl_ruleset_id=ssl-set; ssl_rule_id=ssl-rule; ssl_action=created; cert_id=cert-new
}
reset_old_local(){
  rm -rf "$CF_TXN_BACKUP_DIR"; rm -f "$CF_TXN_STATE"; : > "$DELETE_LOG"
  printf '%s\n' "$old_config" > "$CONFIG_FILE"
  printf '%s\n' "$old_managed" > "$MANAGED_STATE"
  printf 'old-key\n' > "$TLS_DIR/origin.key"; printf 'old-crt\n' > "$TLS_DIR/origin.crt"; rm -f "$TLS_DIR/origin.csr"
  CF_TXN_PHASE=prepared; CF_TXN_BACKUP_READY=false; cf_clear_pending_write
  CF_COMMIT_HOST=""; CF_COMMIT_PORT=""; CF_COMMIT_ZONE_ID=""; CF_COMMIT_ZONE_NAME=""; CF_COMMIT_DNS_ID=""; CF_COMMIT_DNS_OWNED=false; CF_COMMIT_ORIGIN_RULESET_ID=""; CF_COMMIT_ORIGIN_RULE_ID=""; CF_COMMIT_SSL_RULESET_ID=""; CF_COMMIT_SSL_RULE_ID=""; CF_COMMIT_CERT_ID=""
}

# SIGKILL-equivalent boundary: process dies after local TLS/config mutation.
reset_old_local; seed_remote_state; prepare_cloudflare_local_backup; CF_TXN_PHASE=applying; save_current_cloudflare_transaction_state
printf '{"listen_address":"0.0.0.0:3210","tls_cert_file":"new","tls_key_file":"new"}\n' > "$CONFIG_FILE"
printf 'new-key\n' > "$TLS_DIR/origin.key"; printf 'new-crt\n' > "$TLS_DIR/origin.crt"
recover_cloudflare_transaction
cmp -s <(printf '%s\n' "$old_config") "$CONFIG_FILE"
cmp -s <(printf '%s\n' "$old_managed") "$MANAGED_STATE"
grep -qF '/zones/zone1/dns_records/dns-new' "$DELETE_LOG"
grep -qF '/certificates/cert-new' "$DELETE_LOG"
test ! -e "$CF_TXN_STATE"; test ! -e "$CF_TXN_BACKUP_DIR"

# Boundary: managed state was replaced after durable committing intent but the
# process died before it could persist phase=committed. Recovery must finalize,
# not delete now-active Cloudflare resources or restore old local state.
reset_old_local; seed_remote_state; prepare_cloudflare_local_backup
CF_TXN_PHASE=applying; save_current_cloudflare_transaction_state
printf '{"listen_address":"0.0.0.0:3210","tls_cert_file":"new","tls_key_file":"new"}\n' > "$CONFIG_FILE"
printf 'new-key\n' > "$TLS_DIR/origin.key"; printf 'new-crt\n' > "$TLS_DIR/origin.crt"
cf_set_commit_intent mcp.example.com 3210 zone1 example.com dns-new true origin-set origin-rule ssl-set ssl-rule cert-new
cat > "$MANAGED_STATE" <<'JSON'
{"active_provider":"cloudflare","hostname":"mcp.example.com","port":3210,"cloudflare":{"zone_id":"zone1","zone_name":"example.com","dns_record_id":"dns-new","dns_record_owned":true,"origin_ruleset_id":"origin-set","origin_rule_id":"origin-rule","ssl_config_ruleset_id":"ssl-set","ssl_config_rule_id":"ssl-rule","origin_certificate_id":"cert-new"}}
JSON
: > "$DELETE_LOG"
recover_cloudflare_transaction
test ! -s "$DELETE_LOG"
grep -qF '0.0.0.0:3210' "$CONFIG_FILE"
grep -qF 'cert-new' "$MANAGED_STATE"
test ! -e "$CF_TXN_STATE"; test ! -e "$CF_TXN_BACKUP_DIR"

# Boundary: durable committed marker exists but journal deletion never happened.
reset_old_local; seed_remote_state; prepare_cloudflare_local_backup
cf_set_commit_intent mcp.example.com 3210 zone1 example.com dns-new true origin-set origin-rule ssl-set ssl-rule cert-new
cat > "$MANAGED_STATE" <<'JSON'
{"active_provider":"cloudflare","hostname":"mcp.example.com","port":3210,"cloudflare":{"zone_id":"zone1","zone_name":"example.com","dns_record_id":"dns-new","dns_record_owned":true,"origin_ruleset_id":"origin-set","origin_rule_id":"origin-rule","ssl_config_ruleset_id":"ssl-set","ssl_config_rule_id":"ssl-rule","origin_certificate_id":"cert-new"}}
JSON
CF_TXN_PHASE=committed; save_current_cloudflare_transaction_state
: > "$DELETE_LOG"
recover_cloudflare_transaction
test ! -s "$DELETE_LOG"; test ! -e "$CF_TXN_STATE"; test ! -e "$CF_TXN_BACKUP_DIR"

# Malformed/truncated privileged journal fails closed: no Cloudflare mutation,
# no deletion of the journal, and no silent loss of ownership evidence.
reset_old_local
printf '{"version":1,"phase":"applying"' > "$CF_TXN_STATE"
chown root:root "$CF_TXN_STATE"; chmod 0600 "$CF_TXN_STATE"
: > "$DELETE_LOG"
if recover_cloudflare_transaction; then echo 'malformed journal was accepted' >&2; exit 1; fi
test -s "$CF_TXN_STATE"; test ! -s "$DELETE_LOG"

echo 'cloudflare durable phase-recovery tests passed'
''')
