# Normalize only leading raw-string indentation emitted by the appended Go tests.
p = Path("internal/executor/executor_test.go")
lines = p.read_text().splitlines(True)
out = []
in_generated = False
for line in lines:
    if line.startswith("func TestCommandUsesSanitizedRootEnvironment"):
        in_generated = True
    if in_generated:
        prefix = ""
        rest = line
        while rest.startswith("\\t"):
            prefix += "\t"
            rest = rest[2:]
        line = prefix + rest
    out.append(line)
p.write_text("".join(out))
