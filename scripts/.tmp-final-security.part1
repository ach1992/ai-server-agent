\targs := []string{"--unit", unit, "--collect", "--property=WorkingDirectory=" + s.cfg.WorkspaceDir, "--setenv=HOME=" + s.cfg.WorkspaceDir, "--setenv=AI_SERVER_AGENT=1"}
\tif mode != "" {
\t\targs = append(args, mode)
\t}
\targs = append(args, "/bin/bash", "-lc", shell)
\tout, err := exec.Command("systemd-run", args...).CombinedOutput()
''',
    '''\tunit := "ai-job-" + id
\tshell := fmt.Sprintf("( %s ) >>%s 2>&1; rc=$?; printf '%%s\\n' \\\"$rc\\\" >%s; exit \\\"$rc\\\"", req.Command, shellQuote(logPath), shellQuote(statusPath))
\thome := s.cfg.WorkspaceDir
\targs := []string{"--unit", unit, "--collect", "--property=WorkingDirectory=" + s.cfg.WorkspaceDir}
\tif req.Root {
\t\thome = "/root"
\t} else {
\t\targs = append(args, "--uid="+s.cfg.WorkerUser)
\t}
\targs = append(args,
\t\t"/usr/bin/env", "-i",
\t\t"HOME="+home,
\t\t"PATH="+safeCommandPath,
\t\t"LANG=C.UTF-8",
\t\t"LC_ALL=C.UTF-8",
\t\t"AI_SERVER_AGENT=1",
\t\t"/bin/bash", "--noprofile", "--norc", "-c", shell,
\t)
\tout, err := exec.Command("systemd-run", args...).CombinedOutput()
''')

