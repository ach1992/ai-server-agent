append_once(
    "internal/executor/executor_test.go",
    "func TestShellCommandIgnoresWorkerStartupFiles",
    r'''func TestCommandUsesSanitizedRootEnvironment(t *testing.T) {
\tworkspace := t.TempDir()
\ts := &Server{
\t\tcfg:       config.Config{WorkspaceDir: workspace, WorkerUser: "aiworker"},
\t\tguard:     policy.New(nil),
\t\tworkerUID: 1234,
\t\tworkerGID: 1235,
\t}
\trootCmd, _ := s.command(Request{Command: "printf safe", Root: true})
\tif got := strings.Join(rootCmd.Args, " "); strings.Contains(got, " -l") || !strings.Contains(got, "--noprofile --norc -c") {
\t\tt.Fatalf("root shell args are not startup-file-safe: %q", got)
\t}
\tenv := strings.Join(rootCmd.Env, "\n")
\tif !strings.Contains(env, "HOME=/root") || strings.Contains(env, "BASH_ENV=") || strings.Contains(env, "ENV=") {
\t\tt.Fatalf("root environment is not sanitized: %q", env)
\t}
\tif strings.Contains(env, "HOME="+workspace) {
\t\tt.Fatalf("root command inherited worker HOME: %q", env)
\t}
}

func TestShellCommandIgnoresWorkerStartupFiles(t *testing.T) {
\thome := t.TempDir()
\tworkspace := t.TempDir()
\tmarker := filepath.Join(t.TempDir(), "startup-ran")
\tpayload := []byte("printf pwned > " + marker + "\n")
\tfor _, name := range []string{".bash_profile", ".bash_login", ".profile", ".bashrc"} {
\t\tif err := os.WriteFile(filepath.Join(home, name), payload, 0644); err != nil {
\t\t\tt.Fatal(err)
\t\t}
\t}
\tbashEnv := filepath.Join(home, "bash-env")
\tif err := os.WriteFile(bashEnv, payload, 0644); err != nil {
\t\tt.Fatal(err)
\t}
\tt.Setenv("BASH_ENV", bashEnv)
\tt.Setenv("ENV", bashEnv)
\tcmd := newShellCommand("printf safe", home, workspace)
\tout, err := cmd.CombinedOutput()
\tif err != nil {
\t\tt.Fatalf("sanitized shell failed: %v (%s)", err, out)
\t}
\tif string(out) != "safe" {
''')