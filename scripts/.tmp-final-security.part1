\t\tfileUID, fileGID = s.workerUID, s.workerGID
\t\tmode = "--uid=" + s.cfg.WorkerUser
\t}
''',
    '''\tfileUID, fileGID := uint32(0), uint32(0)
\tif !req.Root {
\t\tfileUID, fileGID = s.workerUID, s.workerGID
\t}
''')

