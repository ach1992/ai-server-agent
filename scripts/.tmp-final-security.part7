
# CI/security must execute the new adversarial phase tests and assert no root login shell remains.
replace_once(
    ".github/workflows/ci.yml",
    '''      - name: Shell syntax
        run: bash -n install.sh update.sh uninstall.sh manage.sh scripts/build-release.sh tests/cloudflare_transaction.sh tests/cloudflare_crash_recovery.sh tests/root_trust_boundary.sh tests/root_trust_migration.sh
''',
    '''      - name: Shell syntax
        run: bash -n install.sh update.sh uninstall.sh manage.sh scripts/build-release.sh tests/cloudflare_transaction.sh tests/cloudflare_crash_recovery.sh tests/cloudflare_phase_recovery.sh tests/root_trust_boundary.sh tests/root_trust_migration.sh
      - name: Root shell execution boundary
        run: |
          if grep -nE 'exec.Command\("/bin/bash", "-lc"|"/bin/bash", "-lc", shell|--setenv=HOME=' internal/executor/executor.go; then
            echo 'executor must not use login shells or inherited workspace HOME for privileged execution' >&2
            exit 1
          fi
          grep -qF 'exec.Command("/bin/bash", "--noprofile", "--norc", "-c", command)' internal/executor/executor.go
          grep -qF '"/usr/bin/env", "-i"' internal/executor/executor.go
''')

replace_once(
    ".github/workflows/security.yml",
    '''      - name: Shell syntax
        run: bash -n manage.sh tests/cloudflare_transaction.sh tests/cloudflare_crash_recovery.sh
      - name: Cloudflare mutation rollback and ownership recovery
        run: sudo bash tests/cloudflare_transaction.sh
      - name: Cloudflare SIGKILL crash recovery
        run: sudo bash tests/cloudflare_crash_recovery.sh
''',
    '''      - name: Shell syntax
        run: bash -n manage.sh tests/cloudflare_transaction.sh tests/cloudflare_crash_recovery.sh tests/cloudflare_phase_recovery.sh
      - name: Cloudflare mutation rollback and ownership recovery
        run: sudo bash tests/cloudflare_transaction.sh
      - name: Cloudflare SIGKILL crash recovery
        run: sudo bash tests/cloudflare_crash_recovery.sh
      - name: Cloudflare durable commit and malformed-journal recovery
        run: sudo bash tests/cloudflare_phase_recovery.sh
      - name: Privileged shell startup-file isolation
        run: sudo env PATH="$PATH" go test ./internal/executor -run TestRootCommandAndJobIgnoreWorkerStartupFiles -count=1
''')

# Documentation: persist the actual trust model so future changes are reviewed
# against execution environment + transaction semantics, not just chmod/chown.
append_once(
    "docs/ARCHITECTURE.md",
    "## Privileged execution and durable transaction invariants",
    r'''## Privileged execution and durable transaction invariants

Root execution is isolated from the worker workspace as an execution environment, not only as a filesystem permission boundary. Root commands use a root-trusted HOME, an explicit minimal environment, and Bash with startup files disabled; background root jobs additionally start through `env -i`. Worker-controlled `.bash_profile`, `.bash_login`, `.profile`, `.bashrc`, `BASH_ENV`, or `ENV` must never influence a later root command.

Cloudflare changes use a durable root-only transaction state machine. Remote create intent is journaled before POST; a fixed root-only local rollback snapshot is durable before local TLS/config mutation; phases distinguish `prepared`, `applying`, `committing`, `committed`, and `rolled_back`. `committing` records the exact intended managed-resource identity before managed-state replacement, so fresh recovery can distinguish a completed commit from a rollback case. `committed` recovery only finalizes the journal. Malformed journals fail closed and remain untouched. Recovery deletes exact Agent-owned rules, records, and certificates only; it never deletes an entire Ruleset container because concurrent writers cannot be excluded atomically.
''')

print("final security remediation applied")
