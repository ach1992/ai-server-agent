does not perform unconditional in-place updates of existing Agent-owned DNS/Origin/Configuration rules, and pending Ruleset recovery never deletes an entire Ruleset container because concurrent writers cannot be excluded atomically.''')

# ---------- release workflow: create exact protected tag first, then --verify-tag ----------
release_path = Path('.github/workflows/release.yml')
release = release_path.read_text()
if 'concurrency:\n  group: stable-release' not in release:
    release = release.replace('permissions:\n  contents: write\n  actions: read\n', 'concurrency:\n  group: stable-release\n  cancel-in-progress: false\npermissions:\r
  contents: write\n  actions: read\n', 1)
release = release.replace('''      - name: Require a new release tag\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          set -Eeuo pipefail\n          if gh release view "$RELEASE_TAG" --repo "$GITHUB_REPOSITORY" >/dev/null 2>&1; then\n            echo "Release $RELEASE_TAG already exists; refusing to mutate an existing release." >&2\n            exit 1\n          fi\n          if git ls-remote --exit-code --tags origin "refs/tags/$RELEASE_TAG" >/dev/null 2>&1; then\n            echo "Tag $RELEASE_TAG already exists. This workflow requires an absent tag so GitHub creates it atomically for the exact release SHA." >&2\n            exit 1\n          fi\n''', '''      - name: Require an unpublished release identity\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          set -Eeuo pipefail\n          if gh release view "$RELEASE_TAG" --repo "$GITHUB_REPOSITORY" >/dev/null 2>&1; then\n            echo "Release $RELEASE_TAG already exists; refusing to mutate an existing release." >&2\n            exit 1\n          fi\n          if tag_json="$(gh api "/repos/$GITHUB_REPOSITORY/git/ref/tags/$RELEASE_TAG" 2>/dev/null)"; then\n            test "$(jq -r '.object.type' <<<"$tag_json")" = commit || { echo "Existing $RELEASE_TAG is not a lightweight commit tag." >&2; exit 1; }\n            test "$(jq -r '.object.sha' <<<"$tag_json")" = "$RELEASE_SHA" || { echo "Existing $RELEASE_TAG does not point to validated SHA $RELEASE_SHA." >&2; exit 1; }\n            echo "Exact release tag already exists at the validated SHA; it may be reused only after tag-protection verification."\n          fi\n''', 1)
if 'Require an unpublished release identity' not in release:
    raise SystemExit('release: old require-tag block did not replace')
release = release.replace('''      - name: Recheck manual immutability gate before publication\n        run: |\n          set -Eeuo pipefail\n          test "$IMMUTABILITY_CONFIRMATION" = 'IMMUTABLE_RELEASES_ENABLED'\n          echo "Proceeding only on the operator's immediately preceding repository-setting verification."\n      - name: Publish release payload\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          set -Eeuo pipefail\n          version="${RELEASE_TAG#v}"\n          gh release create "$RELEASE_TAG" \\\n            "dist/ai-server-agent_${version}_linux_amd64.tar.gz" \\\n            dist/SHA256SUMS \\\n            dist/install.sh \\\n            --repo "$GITHUB_REPOSITORY" \\\n            --target "$RELEASE_SHA" \\\n            --generate-notes \\\n            --latest \\\n            --fail-on-no-commits\n''', '''      - name: Verify active immutable release-tag ruleset\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          set -Eeuo pipefail\n          protected=0\n          while IFS= read -r ruleset_id; do\n            [ -n "$ruleset_id" ] || continue\n            ruleset="$(gh api "/repos/$GITHUB_REPOSITORY/rulesets/$ruleset_id")"\n            if jq -e --arg pattern 'refs/tags/v*' '\n              .target=="tag" and .enforcement=="active" and\n              ((.bypass_actors // []) | length)==0 and\n              (((.conditions.ref_name.include // []) | index($pattern)) != null) and\n              (((.conditions.ref_name.exclude // []) | length)==0) and\n              ((([.rules[]?.type] | index("update")) != null)) and\n              ((([.rules[]?.type] | index("deletion")) != null))\n            ' >/dev/null <<<"$ruleset"; then\n              protected=1\n              break\n            fi\n          done < <(gh api "/repos/$GITHUB_REPOSITORY/rulesets?targets=tag&includes_parents=true&per_page=100" --jq '.[] | select(.target == "tag" and .enforcement == "active") | .id')\n          test "$protected" -eq 1 || {\n            echo "Publication is blocked. Create an active tag ruleset covering refs/tags/v* with Restrict updates + Restrict deletions and no bypass actors." >&2\n            exit 1\n          }\n      - name: Recheck manual immutability gate before publication\n        run: |\n          set -Eeuo pipefail\n          test "$IMMUTABILITY_CONFIRMATION" = 'IMMUTABLE_RELEASES_ENABLED'\n          echo "Proceeding only on the operator's immediately preceding repository-setting verification."\n      - name: Create and verify exact protected release tag\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          set -Eeuo pipefail\n          if ! tag_json="$(gh api --method POST "/repos/$GITHUB_REPOSITORY/git/refs" -f ref="refs/tags/$RELEASE_TAG" -f sha="$RELEASE_SHA" 2>/tmp/tag-create.err)"; then\n            tag_json="$(gh api "/repos/$GITHUB_REPOSITORY/git/ref/tags/$RELEASE_TAG" 2>/dev/null)" || { cat /tmp/tag-create.err >&2 || true; echo "Could not create or recover the exact release tag." >&2; exit 1; }\n          fi\n          test "$(jq -r '.object.type' <<<"$tag_json")" = commit\n          test "$(jq -r '.object.sha' <<<"$tag_json")" = "$RELEASE_SHA"\n          remote_tag_json="$(gh api "/repos/$GITHUB_REPOSITORY/git/ref/tags/$RELEASE_TAG")"\n          test "$(jq -r '.object.type' <<<"$remote_tag_json")" = commit\n          remote_tag_sha="$(jq -r '.object.sha' <<<"$remote_tag_json")"\n          test "$remote_tag_sha" = "$RELEASE_SHA"\n      - name: Publish release payload\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          set -Eeuo pipefail\n          remote_tag_json="$(gh api "/repos/$GITHUB_REPOSITORY/git/ref/tags/$RELEASE_TAG")"\n          test "$(jq -r '.object.type' <<<"$remote_tag_json")" = commit\n          remote_tag_sha="$(jq -r '.object.sha' <<<"$remote_tag_json")"\n          test "$remote_tag_sha" = "$RELEASE_SHA"\n          version="${RELEASE_TAG#v}"\n          gh release create "$RELEASE_TAG" \\\n            "dist/ai-server-agent_${version}_linux_amd64.tar.gz" \\\n            dist/SHA256SUMS \\\n            dist/install.sh \\\n            --repo "$GITHUB_REPOSITORY" \\\n            --verify-tag \\\n            --generate-notes \\\n            --latest \\\n            --fail-on-no-commits\n''', 1)
if 'Create and verify exact protected release tag' not in release or '--verify-tag' not in release or '--target "$RELEASE_SHA"' in release:
    raise SystemExit('release: publication remediation incomplete')
Path('scripts/.tmp-release.yml').write_text(release)

# ---------- CI workflow generated copy ----------
ci = Path('.github/workflows/ci.yml').read_text()
