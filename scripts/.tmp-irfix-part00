from pathlib import Path
import re


def sub(path, pattern, repl, count=1, flags=re.S|re.M):
    p = Path(path)
    text = p.read_text()
    new, n = re.subn(pattern, repl, text, count=count, flags=flags)
    if n != count:
        raise SystemExit(f"{path}: expected {count} replacements for {pattern[:80]!r}, got {n}")
    p.write_text(new)


def replace(path, old, new, count=1):
    p = Path(path)
    text = p.read_text()
    n = text.count(old)
    if n != count:
        raise SystemExit(f"{path}: expected {count} exact occurrences, got {n}: {old[:100]!r}")
    p.write_text(text.replace(old, new, count))

